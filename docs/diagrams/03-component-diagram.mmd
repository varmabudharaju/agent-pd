    JUDGE["judge.py<br/>opt-in off_task LLM"]
    SINK["sink.py<br/>off-host forwarder"]

    HOOK --> INTEG
    CLI --> HOOK & STORE & INVEST & LIVE & REPORT & JUDGE & SINK & INSTALL & INTEG
